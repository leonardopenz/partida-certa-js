generator client {
  provider = "prisma-client"
  output   = "../src/server/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  admin
  member
}

enum MatchStatus {
  scheduled
  canceled
}

enum MatchType {
  society
  futsal
  campo
}

enum PresenceStatus {
  confirmed
  canceled
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  name         String @db.VarChar(100)
  email        String @unique @db.VarChar(254)
  passwordHash String
  createdAt    DateTime @default(now())
  sessions     Session[]
  ownedGroups  Group[]
  memberships  GroupMember[]
  presences    MatchPresence[]
}

model Session {
  id        String @id
  userId    String @db.Uuid
  expiresAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@index([userId])
}

model Group {
  id          String @id @default(uuid()) @db.Uuid
  ownerId     String @db.Uuid
  name        String @db.VarChar(100)
  description String @default("") @db.VarChar(1000)
  city        String @default("") @db.VarChar(100)
  teamCount   Int @default(2)
  inviteToken String @unique @default(uuid())
  createdAt   DateTime @default(now())
  owner       User @relation(fields: [ownerId], references: [id])
  members     GroupMember[]
  matches     FootballMatch[]
  @@index([ownerId])
}

model GroupMember {
  groupId  String @db.Uuid
  userId   String @db.Uuid
  role     MemberRole @default(member)
  joinedAt DateTime @default(now())
  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([groupId, userId])
  @@index([userId])
}

model FootballMatch {
  id              String @id @default(uuid()) @db.Uuid
  groupId         String @db.Uuid
  title           String @db.VarChar(100)
  type            MatchType @default(society)
  scheduledAt     DateTime
  durationMinutes Int @default(60)
  minPlayers      Int @default(10)
  maxPlayers      Int @default(20)
  location        String @db.VarChar(300)
  priceCents      Int @default(0)
  notes           String @default("") @db.VarChar(1000)
  presenceToken   String @unique @default(uuid())
  status          MatchStatus @default(scheduled)
  createdAt       DateTime @default(now())
  group           Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  presences       MatchPresence[]
  teams           MatchTeam[]
  @@index([groupId, scheduledAt])
}

model MatchPresence {
  id          String @id @default(uuid()) @db.Uuid
  matchId     String @db.Uuid
  userId      String? @db.Uuid
  guestName   String? @db.VarChar(100)
  cancelHash  String? @unique
  status      PresenceStatus @default(confirmed)
  confirmedAt DateTime @default(now())
  match       FootballMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User? @relation(fields: [userId], references: [id])
  teamEntries TeamPlayer[]
  @@unique([matchId, userId])
  @@index([matchId, status])
}

model MatchTeam {
  id      String @id @default(uuid()) @db.Uuid
  matchId String @db.Uuid
  name    String
  match   FootballMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  players TeamPlayer[]
  @@unique([matchId, name])
}

model TeamPlayer {
  teamId     String @db.Uuid
  presenceId String @db.Uuid
  team       MatchTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  presence   MatchPresence @relation(fields: [presenceId], references: [id], onDelete: Cascade)
  @@id([teamId, presenceId])
  @@unique([presenceId])
}
